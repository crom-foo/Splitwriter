{
  "package": {
    "productName": "Splitwriter",
    "version": "2.0.0-portable"
  },
  "build": {
    "beforeDevCommand": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "beforeBuildCommand": "vite build",
    "devPath": "http://127.0.0.1:5175",
    "distDir": "../dist"
  },
  "tauri": {
    "windows": [
      {
        "label": "main",
        "title": "Splitwriter",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "fileDropEnabled": false,
        "visible": true
      }
    ],
    "allowlist": {
      "window": {
        "all": true
      },
      "fs": {
        "all": true,
        "scope": [
          "**"
        ]
      },
      "path": {
        "all": true
      },
      "dialog": {
        "open": true,
        "save": true,
        "message": true,
        "confirm": true
      },
      "shell": {
        "open": true,
        "execute": true,
        "scope": [
          {
            "name": "explorer",
            "cmd": "explorer.exe",
            "args": true
          }
        ]
      }
    },
    "security": {
      "csp": "default-src 'self' blob: data: ipc: http://localhost:* http://127.0.0.1:*; img-src 'self' blob: data: *; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src http://localhost:* http://127.0.0.1:* ipc:; frame-src 'self' blob: data:"
    },
    "bundle": {
      "identifier": "com.splitwriter.app",
      "icon": [
        "icons/icon.png"
      ]
    }
  }
}
